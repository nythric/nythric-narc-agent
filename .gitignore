# ========================================
# NarcAgent - .gitignore
# ========================================

# Compilacao e Build outputs (raiz e subprojetos)
bin/
obj/
**/bin/
**/obj/
publish/
**/publish/
out/
**/out/
build/
**/build/

# Configuracoes locais de Ambiente e Segredos
.env
.env.*
!.env.example
*.env
*.env.local

# Chaves Criptograficas, Certificados e Artefatos ACME/SSL gerados
*.key
*.crt
*.pem
*.pfx
*.p12
*.cer
*.csr
account.key
certs/
**/certs/
certificates/
**/certificates/
ssl/
**/ssl/
.well-known/

# Dados locais do agente e tokens de autenticacao
Data/
**/Data/
.agent.nortlin
agent.nortlin
token.json
.token*

# Logs
*.log
logs/
**/logs/

# Testes e Cobertura
TestResults/
[Tt]est[Rr]esults/
*.coverage
*.coveragexml

# IDEs, Editores e Arquivos de Usuario
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosv
*.userprefs

# NuGet e Pacotes
*.nupkg
*.snupkg
.nuget/
packages/
**/packages/
project.lock.json
project.assets.json

# Sistema Operacional
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Runtime e Backups
*.runtimeconfig.json.bak
*.orig
*.bak
