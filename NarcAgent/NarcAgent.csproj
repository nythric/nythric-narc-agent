<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>NarcAgent</AssemblyName>
    <RootNamespace>NarcAgent</RootNamespace>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="DotNetEnv" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NarcAgent.Core\NarcAgent.Core.csproj" />
    <ProjectReference Include="..\NarcAgent.Command\NarcAgent.Command.csproj" />
    <ProjectReference Include="..\NarcAgent.Plugins\NarcAgent.Plugins.csproj" />
    <ProjectReference Include="..\NarcAgent.Proxy\NarcAgent.Proxy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update=".env" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
